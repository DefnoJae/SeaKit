{
  "id": "seakit",
  "name": "SeaKit",
  "version": "0.1.13",
  "manifestURI": "https://raw.githubusercontent.com/DefnoJae/SeaKit/main/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Adds optional MAL ratings, English dub status, and an auto open dub toggle for online streaming.",
  "author": "DefnoJae",
  "website": "https://github.com/DefnoJae/SeaKit",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/DefnoJae/SeaKit/56b2c03b5a907e9ce7571e471852c27eb7505e4b/SeaKit.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "api.jikan.moe",
            "myanimelist.net",
            "raw.githubusercontent.com"
          ],
          "reasoning": "SeaKit fetches MyAnimeList scores from Jikan with a direct MyAnimeList page fallback, and English dub status from the MyDubList dataset."
        }
      }
    }
  },
  "icon": "https://raw.githubusercontent.com/DefnoJae/SeaKit/d78f7da7053ed9d64fe903efd6fb43f5b27917de/icon.png"
}
